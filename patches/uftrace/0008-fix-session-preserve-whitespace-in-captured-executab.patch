 {
 	FILE *ifp, *ofp;
-	char buf[PATH_MAX];
+	char buf[PATH_MAX + 256];
 	struct uftrace_mmap *prev_map = NULL;
 	bool prev_written = false;
 
@@ -1219,12 +1219,18 @@ void record_proc_maps(char *dirname, const char *sess_id, struct uftrace_sym_inf
 		unsigned char prev_major = 0, prev_minor = 0;
 		uint32_t ino, prev_ino = 0;
 		uint64_t off, prev_off = 0;
-		char path[PATH_MAX];
+		char *path;
+		int path_offset = 0;
 		struct uftrace_mmap *map;
 
 		/* skip anon mappings */
-		if (sscanf(buf, "%lx-%lx %s %" SCNx64 " %hhx:%hhx %u %s\n", &start, &end, prot,
-			   &off, &major, &minor, &ino, path) != 8)
+		if (sscanf(buf, "%lx-%lx %4s %" SCNx64 " %hhx:%hhx %u %n", &start, &end, prot,
+			   &off, &major, &minor, &ino, &path_offset) != 7 ||
+		    !path_offset || !buf[path_offset])
+			continue;
+		path = buf + path_offset;
+		path[strcspn(path, "\n")] = '\0';
+		if (!*path || strlen(path) >= PATH_MAX)
 			continue;
 
 		/*
