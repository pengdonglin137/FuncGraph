@@ -1345,6 +1363,57 @@ TEST_CASE(session_map_build_id)
 	return TEST_OK;
 }
 
+TEST_CASE(session_map_whitespace_paths)
+{
+	const char *paths[] = {
+		"/tmp/application with spaces",
+		"/tmp/library with spaces.so",
+		"/tmp/library\twith\ttabs.so",
+		"/tmp/trailing spaces  ",
+		"/tmp/file build-id:not-metadata",
+		"/tmp/file build-id:deadbeef",
+	};
+	char long_path[PATH_MAX];
+	struct uftrace_sym_info test_sinfo = {
+		.filename = "/tmp/application with spaces",
+	};
+	struct uftrace_mmap *map;
+	size_t index;
+	FILE *fp;
+
+	fp = fopen("sid-whitespace.map", "w");
+	TEST_NE(fp, NULL);
+	for (index = 0; index < ARRAY_SIZE(paths); index++)
+		fprintf(fp, "%zx-%zx r-xp 00000000 08:03 4096 %s%s\n", (index + 1) * 4096,
+			(index + 2) * 4096, paths[index],
+			index + 1 == ARRAY_SIZE(paths) ? " build-id:"
+						     : index % 2 ? "" : " build-id:1234567890abcdef");
+	memset(long_path, 'a', sizeof(long_path) - 1);
+	long_path[0] = '/';
+	long_path[PATH_MAX / 2] = ' ';
+	long_path[sizeof(long_path) - 1] = '\0';
+	fprintf(fp, "100000-101000 r-xp 00000000 08:03 4096 %s build-id:1234567890abcdef",
+		long_path);
+	fclose(fp);
+
+	read_session_map(".", &test_sinfo, "whitespace");
+	remove("sid-whitespace.map");
+	map = test_sinfo.maps;
+	TEST_EQ(test_sinfo.exec_map, map);
+	for (index = 0; index < ARRAY_SIZE(paths); index++) {
+		TEST_NE(map, NULL);
+		TEST_STREQ(map->libname, paths[index]);
+		TEST_STREQ(map->build_id, index % 2 ? "" : "1234567890abcdef");
+		map = map->next;
+	}
+	TEST_NE(map, NULL);
+	TEST_STREQ(map->libname, long_path);
+	TEST_STREQ(map->build_id, "1234567890abcdef");
+	TEST_EQ(map->next, NULL);
+	delete_session_map(&test_sinfo);
+	return TEST_OK;
+}
