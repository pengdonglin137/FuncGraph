@@ -146,9 +160,10 @@ void update_session_map(const char *filename)
 		pr_err("cannot create new map file: %s", buf);
 
 	while (fgets(buf, sizeof(buf), ifp) != NULL) {
-		char path[PATH_MAX];
+		char *path;
 		char build_id[BUILD_ID_STR_SIZE];
 		int len;
