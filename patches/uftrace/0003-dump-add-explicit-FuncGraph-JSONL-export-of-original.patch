--- a/cmds/dump.c
+++ b/cmds/dump.c
@@ -1445,6 +1445,253 @@ static void dump_mermaid_footer(struct uftrace_dump_ops *ops, struct uftrace_dat
 	pr_out("</html>\n");
 }
 
+static void fgraph_string_n(const char *text, size_t length)
+{
+	size_t index;
+	unsigned char value;
+
+	pr_out("\"");
+	for (index = 0; index < length; index++) {
+		value = text[index];
+		if (value == '"' || value == '\\')
+			pr_out("\\%c", value);
+		else if (value < 32)
+			pr_out("\\u%04x", value);
+		else
+			pr_out("%c", value);
+	}
+	pr_out("\"");
+}
+
+static void fgraph_string(const char *text)
+{
+	fgraph_string_n(text, strlen(text));
+}
+
+static const char *fgraph_type(struct uftrace_record *record)
+{
+	switch (record->type) {
+	case UFTRACE_ENTRY: return "entry";
+	case UFTRACE_EXIT: return "exit";
+	case UFTRACE_LOST: return "lost";
+	default: return "event";
+	}
+}
+
+static void dump_fgraph_header(struct uftrace_dump_ops *ops, struct uftrace_data *handle,
+				struct uftrace_opts *opts)
+{
+	char *path, *line = NULL, *value;
+	size_t length = 0;
+	FILE *fp;
+	bool comma = false;
+
+	pr_out("{\"type\":\"metadata\",\"schema\":\"funcgraph.uftrace.v1\","
+	       "\"order\":\"streams\",\"timestamp_unit\":\"ns\",\"depth_basis\":\"address-space\","
+	       "\"kernel_settings\":{");
+	xasprintf(&path, "%s/kernel-funcgraph.info", opts->dirname);
+	fp = fopen(path, "r");
+	free(path);
+	if (fp) {
+		while (getline(&line, &length, fp) >= 0) {
+			value = strchr(line, '=');
+			if (!value)
+				continue;
+			*value++ = '\0';
+			value[strcspn(value, "\n")] = '\0';
+			if (comma)
+				pr_out(",");
+			comma = true;
+			fgraph_string(line);
+			pr_out(":");
+			fgraph_string(value);
+		}
+		free(line);
+		fclose(fp);
+	}
+	pr_out("},\"clock\":");
+	xasprintf(&path, "%s/funcgraph-clock", opts->dirname);
+	fp = fopen(path, "r");
+	free(path);
+	line = NULL;
+	length = 0;
+	if (fp && getline(&line, &length, fp) >= 0) {
+		line[strcspn(line, "\n")] = '\0';
+		fgraph_string(line);
+	}
+	else
+		pr_out("null");
+	free(line);
+	if (fp)
+		fclose(fp);
+	pr_out("}\n");
+}
+
+static void dump_fgraph_task(struct uftrace_dump_ops *ops, struct uftrace_task_reader *task,
+			     char *name)
+{
+	struct uftrace_record *record = task->rstack;
+	struct uftrace_dbg_loc *loc;
+	unsigned index;
+
+	pr_out("{\"type\":\"%s\",\"space\":\"user\",\"time_ns\":%" PRIu64
+	       ",\"tid\":%d,\"pid\":%d,\"cpu\":null,\"depth\":%u,\"address\":\"0x%" PRIx64 "\",\"name\":",
+	       fgraph_type(record), record->time, task->tid, task->t->pid, record->depth, record->addr);
+	fgraph_string(name);
+	pr_out(",\"comm\":");
+	fgraph_string(task->t->comm);
+	if (record->type == UFTRACE_LOST)
+		pr_out(",\"count\":%" PRIu64, record->addr);
+	if (record->more && task->args.data) {
+		pr_out(",\"payload_hex\":\"");
+		for (index = 0; index < task->args.len; index++)
+			pr_out("%02x", ((unsigned char *)task->args.data)[index]);
+		pr_out("\"");
+	}
+	loc = task_find_loc_addr(&task->h->sessions, task, record->time, record->addr);
+	if (loc && loc->file && loc->line) {
+		pr_out(",\"source\":{\"file\":");
+		fgraph_string(loc->file->name);
+		pr_out(",\"line\":%d}", loc->line);
+	}
+	pr_out("}\n");
+}
+
+static void dump_fgraph_task_event(struct uftrace_dump_ops *ops, struct uftrace_task_reader *task)
+{
+	char *name = event_get_name(task->h, task->rstack->addr);
+	dump_fgraph_task(ops, task, name);
+	free(name);
+}
+
+static void dump_fgraph_footer(struct uftrace_dump_ops *ops, struct uftrace_data *handle,
+				struct uftrace_opts *opts)
+{
+	pr_out("{\"type\":\"end\",\"complete\":%s}\n", uftrace_done ? "false" : "true");
+}
+
+static void fgraph_context(struct uftrace_kernel_context *ctx)
+{
+	int index;
+
+	if (ctx->has_flags)
+		pr_out(",\"common_flags\":%" PRIu64, ctx->flags);
+	if (ctx->has_preempt)
+		pr_out(",\"common_preempt_count\":%" PRIu64, ctx->preempt_count);
+	if (ctx->has_retaddr)
+		pr_out(",\"retaddr\":\"0x%" PRIx64 "\"", ctx->retaddr);
+	if (ctx->has_retval)
+		pr_out(",\"retval\":\"0x%" PRIx64 "\"", ctx->retval);
+	if (ctx->has_calltime)
+		pr_out(",\"calltime_ns\":%" PRIu64, ctx->calltime);
+	if (ctx->has_rettime)
+		pr_out(",\"rettime_ns\":%" PRIu64, ctx->rettime);
+	if (ctx->has_overrun)
+		pr_out(",\"overrun\":%" PRIu64, ctx->overrun);
+	if (ctx->nr_args == -2)
+		pr_err("cannot decode recorded kernel arguments for FuncGraph export");
+	if (ctx->nr_args >= 0) {
+		pr_out(",\"args\":[");
+		for (index = 0; index < ctx->nr_args; index++)
+			pr_out("%s\"0x%" PRIx64 "\"", index ? "," : "", ctx->args[index]);
+		pr_out("]");
+	}
+}
+
+static void dump_fgraph_kernel(struct uftrace_dump_ops *ops,
+			       struct uftrace_kernel_reader *kernel, int cpu,
+			       struct uftrace_record *record, char *name)
+{
+	struct uftrace_kernel_context *ctx = &kernel->parser.context;
+
+	pr_out("{\"type\":\"%s\",\"space\":\"kernel\",\"time_ns\":%" PRIu64
+	       ",\"tid\":%d,\"cpu\":%d,\"depth\":%" PRIu64 ",\"address\":\"0x%" PRIx64 "\",\"name\":",
+	       fgraph_type(record), record->time, ctx->common_pid, kernel->cpu_ids[cpu], ctx->depth, ctx->func);
+	fgraph_string(name);
+	fgraph_context(ctx);
+	pr_out("}\n");
+}
+
+static void dump_fgraph_event(struct uftrace_dump_ops *ops,
+			      struct uftrace_kernel_reader *kernel, int cpu,
+			      struct uftrace_record *record)
+{
+	struct uftrace_kernel_context *ctx = &kernel->parser.context;
+	void *event = kparser_find_event(&kernel->parser, record->addr);
+	char name[512];
+	int size;
+	char *data;
+
+	if (!event)
+		return;
+	kparser_event_name(&kernel->parser, event, name, sizeof(name));
+	data = read_kernel_event(kernel, cpu, &size);
+	pr_out("{\"type\":\"event\",\"space\":\"kernel\",\"time_ns\":%" PRIu64
+	       ",\"tid\":%d,\"cpu\":%d,\"name\":", record->time, ctx->common_pid, kernel->cpu_ids[cpu]);
+	fgraph_string(name);
+	pr_out(",\"text\":");
+	fgraph_string_n(data, size);
+	fgraph_context(ctx);
+	pr_out("}\n");
+}
+
+struct uftrace_fgraph_dump {
+	struct uftrace_dump_ops ops;
+	int cpu;
+};
+
+static void dump_fgraph_cpu(struct uftrace_dump_ops *ops,
+			    struct uftrace_kernel_reader *kernel, int cpu)
+{
+	struct uftrace_fgraph_dump *dump = container_of(ops, typeof(*dump), ops);
+	dump->cpu = kernel->cpu_ids[cpu];
+}
+
+static void dump_fgraph_perf_start(struct uftrace_dump_ops *ops,
+				  struct uftrace_perf_reader *perf, int stream)
+{
+	struct uftrace_fgraph_dump *dump = container_of(ops, typeof(*dump), ops);
+	dump->cpu = stream;
+}
+
+static void dump_fgraph_perf(struct uftrace_dump_ops *ops, struct uftrace_perf_reader *perf,
+			     struct uftrace_record *record)
+{
+	struct uftrace_fgraph_dump *dump = container_of(ops, typeof(*dump), ops);
+	char *name = event_get_name(NULL, record->addr);
+	pr_out("{\"type\":\"event\",\"origin\":\"perf\",\"space\":null,\"time_ns\":%" PRIu64
+	       ",\"tid\":%d,\"cpu\":null,\"stream\":%d,\"event_id\":%" PRIu64 ",\"name\":",
+	       record->time, perf->tid, dump->cpu, record->addr);
+	fgraph_string(name);
+	free(name);
+	switch (record->addr) {
+	case EVENT_ID_PERF_SCHED_IN:
+	case EVENT_ID_PERF_SCHED_OUT:
+		pr_out(",\"out\":%s,\"preempt\":%s", perf->u.ctxsw.out ? "true" : "false",
+		       perf->u.ctxsw.preempt ? "true" : "false");
+		break;
+	case EVENT_ID_PERF_TASK:
+	case EVENT_ID_PERF_EXIT:
+		pr_out(",\"pid\":%d,\"ppid\":%d", perf->u.task.pid, perf->u.task.ppid);
+		break;
+	case EVENT_ID_PERF_COMM:
+		pr_out(",\"pid\":%d,\"exec\":%s,\"comm\":", perf->u.comm.pid,
+		       perf->u.comm.exec ? "true" : "false");
+		fgraph_string_n(perf->u.comm.comm, strnlen(perf->u.comm.comm, sizeof(perf->u.comm.comm)));
+		break;
+	default:
+		break;
+	}
+	pr_out("}\n");
+}
+
+static void dump_fgraph_lost(struct uftrace_dump_ops *ops, uint64_t time, int tid, int losts)
+{
+	struct uftrace_fgraph_dump *dump = container_of(ops, typeof(*dump), ops);
+	pr_out("{\"type\":\"lost\",\"space\":\"kernel\",\"time_ns\":%" PRIu64
+	       ",\"tid\":null,\"cpu\":%d,\"count\":%d}\n", time, dump->cpu, losts);
+}
