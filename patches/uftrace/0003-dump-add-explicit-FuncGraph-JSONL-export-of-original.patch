@@ -1525,7 +1772,8 @@ static void do_dump_file(struct uftrace_dump_ops *ops, struct uftrace_opts *opts
 
 		call_if_nonull(ops->cpu_start, ops, kernel, i);
 
-		while (!read_kernel_cpu_data(kernel, i) && !uftrace_done) {
+		int read_status;
+		while ((read_status = read_kernel_cpu_data(kernel, i)) == 0 && !uftrace_done) {
 			int tid = kernel->tids[i];
 			int losts = kparser_missed_events(&kernel->parser, i);
 			struct uftrace_symbol *sym = NULL;
@@ -1554,6 +1802,8 @@ static void do_dump_file(struct uftrace_dump_ops *ops, struct uftrace_opts *opts
 
 			symbol_putname(sym, name);
 		}
+		if (format_mode == FORMAT_FGRAPH && read_status < 0)
+			pr_err("cannot decode kernel CPU %d for FuncGraph export", i);
 	}
 
 perf:
@@ -1855,7 +2105,25 @@ int command_dump(int argc, char *argv[], struct uftrace_opts *opts)
 	if (opts->show_args)
 		show_args = true;
 
-	if (format_mode == FORMAT_CHROME) {
+	if (format_mode == FORMAT_FGRAPH) {
+		struct uftrace_fgraph_dump dump = {
+			.ops = {
+				.header = dump_fgraph_header,
+				.task_rstack = dump_fgraph_task,
+				.task_event = dump_fgraph_task_event,
+				.cpu_start = dump_fgraph_cpu,
+				.kernel_func = dump_fgraph_kernel,
+				.kernel_event = dump_fgraph_event,
+				.lost = dump_fgraph_lost,
+				.perf_start = dump_fgraph_perf_start,
+				.perf_event = dump_fgraph_perf,
+				.footer = dump_fgraph_footer,
+			},
+		};
+
+		do_dump_file(&dump.ops, opts, &handle);
+	}
+	else if (format_mode == FORMAT_CHROME) {
 		struct uftrace_chrome_dump dump = {
 			.ops = {
 				.header         = dump_chrome_header,
diff --git a/cmds/record.c b/cmds/record.c
