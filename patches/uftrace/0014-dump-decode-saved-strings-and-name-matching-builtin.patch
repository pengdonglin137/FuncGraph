From 770394bd77e763f93eb5d17b8c5298f8f32b74ce Mon Sep 17 00:00:00 2001
From: pengdonglin <pengdonglin@xiaomi.com>
Date: Thu, 12 Nov 2026 10:34:41 +0800
Subject: [PATCH] dump: decode saved strings and name matching builtin
 arguments

Decode length-prefixed C and C++ string arguments using the recorded target endian and four-byte alignment. Preserve empty strings, quoted paths, control and arbitrary bytes as escaped literals, retain complete original payloads, and fail closed for unsupported adjacent layouts. Export enum values numerically without dropping neighboring scalar arguments.

Generate a sorted parameter-name table from the pinned upstream prototypes. Use it only for PLT calls whose captured index, ABI location, format, width and enum identity match; preserve recorded DWARF priority and explicit per-argument dwarf/prototype provenance. Do not invent optional variadic arguments or borrow libc names for same-named local functions.

Validated by 130 Python native/import/browser regressions including string padding, quotes, non-ASCII bytes, std::string, raw-byte fallback, manual layout mismatches, offline metadata and escaped HTML; upstream unit tests: 115 passed, one skipped.
---
 cmds/dump.c          |  75 +++++++-
 misc/gen-autoargs.py |  12 ++
 utils/argspec.h      |   1 +
 utils/auto-args.c    |  31 +++
 utils/auto-args.h    | 448 +++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 565 insertions(+), 2 deletions(-)

diff --git a/cmds/dump.c b/cmds/dump.c
index 063fb068acdb..7806575fb289 100644
--- a/cmds/dump.c
+++ b/cmds/dump.c
@@ -1682,6 +1682,31 @@ static void dump_fgraph_header(struct uftrace_dump_ops *ops, struct uftrace_data
 	pr_out("}\n");
 }
 
+static void fgraph_user_string(const unsigned char *text, size_t length)
+{
+	char *literal = xmalloc(4 * length + 3), *output = literal;
+	size_t position;
+
+	*output++ = '"';
+	for (position = 0; position < length; position++) {
+		unsigned char value = text[position];
+		if (value == '"' || value == '\\') {
+			*output++ = '\\';
+			*output++ = value;
+		}
+		else if (value < 32 || value >= 127) {
+			snprintf(output, 5, "\\x%02x", value);
+			output += 4;
+		}
+		else
+			*output++ = value;
+	}
+	*output++ = '"';
+	*output = '\0';
+	fgraph_string(literal);
+	free(literal);
+}
+
 static void fgraph_user_values(struct uftrace_task_reader *task, bool retval)
 {
 	const struct uftrace_fstack_args *args = &task->args;
@@ -1689,11 +1714,17 @@ static void fgraph_user_values(struct uftrace_task_reader *task, bool retval)
 	const int endian = task->h->hdr.endian;
 	struct uftrace_arg_spec *spec;
 	char values[32][32];
+	const unsigned char *texts[32] = {};
+	size_t lengths[32] = {};
+	const char *sources[32] = {};
+	struct uftrace_symbol *function = task_find_sym_addr(&task->h->sessions, task,
+							task->rstack->time, task->rstack->addr);
 	uint64_t symbol_address = 0;
 	struct uftrace_dbg_info *parameters = retval ? NULL :
 		task_find_parameter_info(&task->h->sessions, task, &symbol_address);
 	const char *names[32];
 	bool has_names = false;
+	bool has_prototypes = false;
 	size_t offset = 0;
 	unsigned count = 0, index;
 
@@ -1707,7 +1738,21 @@ static void fgraph_user_values(struct uftrace_task_reader *task, bool retval)
 
 		if (retval != (spec->idx == RETVAL_IDX))
 			continue;
-		if (count >= ARRAY_SIZE(values) || (size != 1 && size != 2 && size != 4 && size != 8) ||
+		if (count >= ARRAY_SIZE(values) || offset > args->len)
+			return;
+		if (spec->fmt == ARG_FMT_STR || spec->fmt == ARG_FMT_STD_STRING) {
+			if (retval || args->len - offset < 2)
+				return;
+			size = endian == ELFDATA2LSB ? bytes[offset] | bytes[offset + 1] << 8 :
+				bytes[offset] << 8 | bytes[offset + 1];
+			padded = (size + 2 + 3) & ~3U;
+			if (padded > args->len - offset)
+				return;
+			texts[count] = bytes + offset + 2;
+			lengths[count] = size;
+			goto parameter;
+		}
+		if ((size != 1 && size != 2 && size != 4 && size != 8) ||
 		    padded > args->len - offset)
 			return;
 		for (index = 0; index < size; index++) {
@@ -1719,6 +1764,7 @@ static void fgraph_user_values(struct uftrace_task_reader *task, bool retval)
 		signed_value = value & sign ? -(int64_t)(mask ^ value) - 1 : (int64_t)value;
 		switch (spec->fmt) {
 		case ARG_FMT_AUTO:
+		case ARG_FMT_ENUM:
 			if (value <= 100000 || value >= UINT64_MAX - 99999)
 				snprintf(values[count], sizeof(values[count]), "%" PRId64, signed_value);
 			else if (value > UINT64_C(0xffff0000) && value <= UINT32_MAX)
@@ -1740,8 +1786,18 @@ static void fgraph_user_values(struct uftrace_task_reader *task, bool retval)
 		default:
 			return;
 		}
+	parameter:
 		offset += padded;
 		names[count] = parameters ? get_dwarf_argname(parameters, symbol_address, spec) : NULL;
+		if (names[count])
+			sources[count] = "dwarf";
+		else if (!retval && function && function->type == ST_PLT_FUNC) {
+			names[count] = get_auto_argname(function->name, spec, task->h->hdr.elf_class == ELFCLASS64);
+			if (names[count]) {
+				sources[count] = "prototype";
+				has_prototypes = true;
+			}
+		}
 		has_names |= names[count] != NULL;
 		count++;
 	}
@@ -1756,7 +1812,10 @@ static void fgraph_user_values(struct uftrace_task_reader *task, bool retval)
 	for (index = 0; index < count; index++) {
 		if (index)
 			pr_out(",");
-		fgraph_string(values[index]);
+		if (texts[index])
+			fgraph_user_string(texts[index], lengths[index]);
+		else
+			fgraph_string(values[index]);
 	}
 	pr_out("]");
 	if (has_names) {
@@ -1771,6 +1830,18 @@ static void fgraph_user_values(struct uftrace_task_reader *task, bool retval)
 		}
 		pr_out("]");
 	}
+	if (has_prototypes) {
+		pr_out(",\"user_arg_name_sources\":[");
+		for (index = 0; index < count; index++) {
+			if (index)
+				pr_out(",");
+			if (sources[index])
+				fgraph_string(sources[index]);
+			else
+				pr_out("null");
+		}
+		pr_out("]");
+	}
 }
 
 static void dump_fgraph_task(struct uftrace_dump_ops *ops, struct uftrace_task_reader *task,
diff --git a/misc/gen-autoargs.py b/misc/gen-autoargs.py
index 1b705e1fe723..4fc32e013840 100755
--- a/misc/gen-autoargs.py
+++ b/misc/gen-autoargs.py
@@ -289,6 +289,7 @@ if __name__ == "__main__":
     enum_list = ""
     args_list = ""
     retvals_list = ""
+    parameter_names = []
 
     # operator new and delete and their variations
     args_list     = '\t\"_Znwm@arg1/u;\"\n'   \
@@ -342,6 +343,13 @@ if __name__ == "__main__":
                 retvals_list += '\t"' + retval_format + ';"\n'
             if args_format:
                 args_list += '\t"' + args_format + ';"\n'
+                declarations = line[line.index('(') + 1:line.rindex(')')].split(',')
+                specifications = args_format.split('@', 1)[1].split(',')
+                if len(declarations) == len(specifications):
+                    for declaration, specification in zip(declarations, specifications):
+                        parameter = re.search(r'\b([A-Za-z_]\w*)\s*$', declaration)
+                        if parameter and parameter.group(1) not in type_specifier:
+                            parameter_names.append((funcname, specification, parameter.group(1)))
 
     if verbose:
         print(enum_list)
@@ -370,6 +378,10 @@ if __name__ == "__main__":
     fout.write("static char *auto_retvals_list =\n")
     fout.write(retvals_list)
     fout.write(";\n\n")
+    fout.write("static const struct { const char *function, *specification, *name; } auto_parameter_names[] = {\n")
+    for function, specification, name in sorted(parameter_names):
+        fout.write('\t{ "' + function + '", "' + specification + '", "' + name + '" },\n')
+    fout.write("};\n\n")
     fout.write("/* clang-format on */\n")
 
     if argspec_file != "-":
