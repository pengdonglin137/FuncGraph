diff --git a/utils/auto-args.c b/utils/auto-args.c
index 8b72b8e61656..24b6cb186040 100644
--- a/utils/auto-args.c
+++ b/utils/auto-args.c
@@ -21,6 +21,37 @@ static struct rb_root auto_argspec = RB_ROOT;
 static struct rb_root auto_retspec = RB_ROOT;
 static struct rb_root auto_enum = RB_ROOT;
 
+const char *get_auto_argname(const char *function, const struct uftrace_arg_spec *spec, bool lp64)
+{
+	struct uftrace_filter_setting setting = { .lp64 = lp64 };
+	size_t first = 0, last = ARRAY_SIZE(auto_parameter_names), position;
+
+	if (spec->type != ARG_TYPE_INDEX && spec->type != ARG_TYPE_FLOAT)
+		return NULL;
+	while (first < last) {
+		size_t middle = first + (last - first) / 2;
+		if (strcmp(auto_parameter_names[middle].function, function) < 0)
+			first = middle + 1;
+		else
+			last = middle;
+	}
+	for (position = first; position < ARRAY_SIZE(auto_parameter_names) &&
+	     !strcmp(auto_parameter_names[position].function, function); position++) {
+		char *description = xstrdup(auto_parameter_names[position].specification);
+		struct uftrace_arg_spec *expected = parse_argspec(description, &setting);
+		bool matches = expected && expected->idx == spec->idx && expected->type == spec->type &&
+			expected->fmt == spec->fmt && expected->size == spec->size &&
+			(!expected->type_name == !spec->type_name) &&
+			(!expected->type_name || !strcmp(expected->type_name, spec->type_name));
+		free(description);
+		if (expected)
+			free_arg_spec(expected);
+		if (matches)
+			return auto_parameter_names[position].name;
+	}
+	return NULL;
+}
+
