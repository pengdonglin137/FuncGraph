+struct uftrace_dbg_info *task_find_parameter_info(struct uftrace_session_link *sessions,
+						struct uftrace_task_reader *task, uint64_t *address)
+{
+	struct uftrace_module *module;
+	struct uftrace_symbol *symbol;
+	uint64_t offset;
+
+	if (task_find_addr_module(sessions, task, task->rstack->time, task->rstack->addr,
+				  &module, &symbol, &offset) < 0 || !module ||
+	    offset < symbol->addr || offset - symbol->addr >= symbol->size)
+		return NULL;
+	*address = symbol->addr;
+	return &module->dinfo;
