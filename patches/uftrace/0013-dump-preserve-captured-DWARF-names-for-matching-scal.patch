+static bool same_arg_location(const struct uftrace_arg_spec *left,
+			      const struct uftrace_arg_spec *right)
+{
+	if (left->type != right->type || left->idx != right->idx ||
+	    (left->fmt == ARG_FMT_FLOAT) != (right->fmt == ARG_FMT_FLOAT) ||
+	    left->struct_reg_cnt != right->struct_reg_cnt)
+		return false;
+	if ((left->type == ARG_TYPE_REG || left->type == ARG_TYPE_STACK) &&
+	    left->reg_idx != right->reg_idx)
+		return false;
+	return !memcmp(left->struct_regs, right->struct_regs,
+		       left->struct_reg_cnt * sizeof(left->struct_regs[0]));
+}
+
+static void add_debug_argname(struct uftrace_dbg_info *dinfo, const char *func, uint64_t offset,
+			      const struct uftrace_arg_spec *spec, const char *name)
+{
+	struct debug_entry *entry;
+	struct debug_argname *argument;
+	const unsigned char *character = (const unsigned char *)name;
+
+	if (!name || !*name || strlen(name) > 1024)
+		return;
+	for (; *character; character++) {
+		if (*character < 32 || *character == 127)
+			return;
+	}
+	entry = find_debug_entry(&dinfo->argnames, offset);
+	if (!entry) {
+		add_debug_entry(&dinfo->argnames, func, offset, "");
+		entry = find_debug_entry(&dinfo->argnames, offset);
+	}
+	list_for_each_entry(argument, &entry->argnames, list) {
+		if (same_arg_location(&argument->spec, spec)) {
+			if (argument->name && strcmp(argument->name, name)) {
+				free(argument->name);
+				argument->name = NULL;
+			}
+			return;
+		}
+	}
+	argument = xzalloc(sizeof(*argument));
+	argument->spec = *spec;
+	argument->name = xstrdup(name);
+	list_add_tail(&argument->list, &entry->argnames);
+}
+
+const char *get_dwarf_argname(struct uftrace_dbg_info *dinfo, uint64_t addr,
+			     const struct uftrace_arg_spec *spec)
+{
+	struct debug_entry *entry = find_debug_entry(&dinfo->argnames, addr);
+	struct debug_argname *argument;
+
+	if (!entry)
+		return NULL;
+	list_for_each_entry(argument, &entry->argnames, list) {
+		if (same_arg_location(&argument->spec, spec))
+			return argument->name;
+	}
+	return NULL;
+}
+
+static void load_debug_argname(struct uftrace_dbg_info *dinfo, const char *func, uint64_t offset,
+			       char *description)
+{
+	struct uftrace_arg_spec argument = {};
+	long fields[9];
+	char *end;
+	size_t length;
+	int position;
+
+	for (position = 0; position < 9; position++) {
+		errno = 0;
+		fields[position] = strtol(description, &end, 10);
+		if (errno || end == description || *end != ' ')
+			return;
+		description = end + 1;
+	}
+	if (fields[0] < ARG_TYPE_INDEX || fields[0] > ARG_TYPE_STACK ||
+	    fields[1] <= 0 || fields[1] > 4096 || fields[2] < 0 || fields[2] > SHRT_MAX ||
+	    (fields[3] != 0 && fields[3] != 1) || fields[4] < 0 || fields[4] > 4)
+		return;
+	for (position = 5; position < 9; position++) {
+		if (fields[position] < 0 || fields[position] > SHRT_MAX)
+			return;
+		argument.struct_regs[position - 5] = fields[position];
+	}
+	argument.type = fields[0];
+	argument.idx = fields[1];
+	argument.reg_idx = fields[2];
+	argument.fmt = fields[3] ? ARG_FMT_FLOAT : ARG_FMT_AUTO;
+	argument.struct_reg_cnt = fields[4];
+	length = strlen(description);
+	if (length && description[length - 1] == '\n')
+		description[--length] = '\0';
+	if (length && description[length - 1] == '\r')
+		description[--length] = '\0';
+	add_debug_argname(dinfo, func, offset, &argument, description);
+}
