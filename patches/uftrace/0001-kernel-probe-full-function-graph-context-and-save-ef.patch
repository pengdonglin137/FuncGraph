From 9046c1b2e99a7ebdaee8a6842d68ef9d51236999 Mon Sep 17 00:00:00 2001
From: pengdonglin <pengdonglin@xiaomi.com>
Date: Wed, 11 Nov 2026 05:23:35 +0800
Subject: [PATCH 1/7] kernel: probe full function-graph context and save
 effective settings

Add --kernel-full-info to enable optional args, retval and return-address options plus available scheduler switch/waking/wakeup events. Missing optional capabilities do not prevent a capture. Save the actual trace clock, running kernel release and option/event readbacks beside every kernel capture, including unsupported states, rather than assuming requested options took effect. Leave default kernel-only recording options unchanged.
---
 uftrace.c      |  9 +++++++
 uftrace.h      |  1 +
 utils/kernel.c | 64 ++++++++++++++++++++++++++++++++++++++++++++++++++
 utils/kernel.h |  1 +
 4 files changed, 75 insertions(+)

diff --git a/uftrace.c b/uftrace.c
index 4b044c1b0da8..fcd22d969fdf 100644
--- a/uftrace.c
+++ b/uftrace.c
@@ -84,6 +84,7 @@ enum uftrace_short_options {
 	OPT_kernel_bufsize,
 	OPT_kernel_skip_out,
 	OPT_kernel_full,
+	OPT_kernel_full_info,
 	OPT_kernel_only,
 	OPT_list_event,
 	OPT_run_cmd,
@@ -456,6 +457,7 @@ static const struct option uftrace_options[] = {
 	REQ_ARG(kernel-buffer, OPT_kernel_bufsize),
 	NO_ARG(kernel-skip-out, OPT_kernel_skip_out),
 	NO_ARG(kernel-full, OPT_kernel_full),
+	NO_ARG(kernel-full-info, OPT_kernel_full_info),
 	NO_ARG(kernel-only, OPT_kernel_only),
 	REQ_ARG(output-fields, 'f'),
 	REQ_ARG(time-range, 'r'),
@@ -1165,6 +1167,13 @@ static int parse_option(struct uftrace_opts *opts, int key, char *arg)
 		opts->kernel_skip_out = true;
 		break;
 
+	case OPT_kernel_full_info:
+		opts->kernel_full_info = true;
+		opts->kernel = true;
+		if (!opts->kernel_depth)
+			opts->kernel_depth = 30;
+		break;
+
 	case OPT_kernel_full:
 		opts->kernel_skip_out = false;
 		/* see setup_kernel_tracing() also */
diff --git a/uftrace.h b/uftrace.h
index 57e72e17b55b..2bf843592bd2 100644
--- a/uftrace.h
+++ b/uftrace.h
@@ -299,6 +299,7 @@ struct uftrace_opts {
 	bool flame_graph;
 	bool libmcount_single;
 	bool kernel;
+	bool kernel_full_info;
 	bool kernel_skip_out; /* also affects VDSO filter */
 	bool kernel_only;
 	bool keep_pid;
diff --git a/utils/kernel.c b/utils/kernel.c
index 26cb4b32c2ec..7b2bddf63729 100644
--- a/utils/kernel.c
+++ b/utils/kernel.c
@@ -12,6 +12,7 @@
 #include <inttypes.h>
 #include <stdio.h>
 #include <sys/stat.h>
+#include <sys/utsname.h>
 #include <unistd.h>
 
 /* This should be defined before #include "utils.h" */
@@ -126,6 +127,18 @@ bool check_kernel_pid_filter(void)
 
 static int set_tracing_options(struct uftrace_kernel_writer *kernel)
 {
+	const char *options[] = { "funcgraph-retval", "funcgraph-args", "funcgraph-retaddr" };
+	size_t i;
+	char name[128];
+
+	if (kernel->full_info) {
+		for (i = 0; i < ARRAY_SIZE(options); i++) {
+			snprintf(name, sizeof(name), "options/%s", options[i]);
+			if (write_tracing_file(name, "1") < 0)
+				pr_dbg("optional kernel tracing option unavailable: %s\n", name);
+		}
+	}
+
 	/* old kernels don't have the options, ignore errors */
 	if (!write_tracing_file("options/function-fork", "1"))
 		write_tracing_file("options/event-fork", "1");
@@ -497,6 +510,19 @@ int setup_kernel_tracing(struct uftrace_kernel_writer *kernel, struct uftrace_op
 	build_kernel_filter(kernel, opts->patch, opts->patt_type, &kernel->patches,
 			    &kernel->nopatch);
 	build_kernel_event(kernel, opts->event, opts->patt_type, &kernel->events);
+	kernel->full_info = opts->kernel_full_info;
+	if (kernel->full_info) {
+		const char *events[] = { "sched_switch", "sched_waking", "sched_wakeup" };
+		char path[128], event[128], value[32];
+
+		for (i = 0; i < ARRAY_SIZE(events); i++) {
+			snprintf(path, sizeof(path), "events/sched/%s/enable", events[i]);
+			if (read_tracing_file(path, value, sizeof(value)) < 0)
+				continue;
+			snprintf(event, sizeof(event), "sched:%s", events[i]);
+			add_single_event(&kernel->events, event);
+		}
+	}
 
 	if (opts->kernel)
 		kernel->tracer = KERNEL_GRAPH_TRACER;
@@ -839,12 +865,50 @@ out:
 	return ret;
 }
 
+static void save_kernel_full_info(struct uftrace_kernel_writer *kernel)
+{
+	const char *settings[] = {
+		"trace_clock", "options/funcgraph-retval", "options/funcgraph-args",
+		"options/funcgraph-retaddr", "options/function-fork", "options/event-fork",
+		"events/sched/sched_switch/enable", "events/sched/sched_waking/enable",
+		"events/sched/sched_wakeup/enable",
+	};
+	char *path;
+	char value[1024];
+	struct utsname uts;
+	FILE *fp;
+	size_t i;
+	ssize_t length;
+
+	xasprintf(&path, "%s/kernel-funcgraph.info", kernel->output_dir);
+	fp = fopen(path, "w");
+	free(path);
+	if (!fp)
+		pr_err("cannot write kernel funcgraph metadata");
+	if (!uname(&uts))
+		fprintf(fp, "kernel_release=%s\n", uts.release);
+	for (i = 0; i < ARRAY_SIZE(settings); i++) {
+		length = read_tracing_file(settings[i], value, sizeof(value) - 1);
+		if (length < 0)
+			strcpy(value, "unavailable");
+		else {
+			value[length] = '\0';
+			value[strcspn(value, "\n")] = '\0';
+		}
+		fprintf(fp, "%s=%s\n", settings[i], value);
+	}
+	if (fclose(fp))
+		pr_err("cannot finish kernel funcgraph metadata");
+}
+
 static int save_kernel_files(struct uftrace_kernel_writer *kernel)
 {
 	char *path = NULL;
 	FILE *fp;
 	int ret = -1;
 
+	save_kernel_full_info(kernel);
+
 	xasprintf(&path, "%s/kernel_header", kernel->output_dir);
 
 	fp = fopen(path, "w");
diff --git a/utils/kernel.h b/utils/kernel.h
index 4c6347589c14..b2c47c049968 100644
--- a/utils/kernel.h
+++ b/utils/kernel.h
@@ -19,6 +19,7 @@ struct uftrace_kernel_writer {
 	int *fds;
