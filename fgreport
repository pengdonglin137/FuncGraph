#!/usr/bin/env python3
"""fgreport: funcgraph.py with sensible defaults, so a report is one short command.

    fgreport trace.txt                      # all features, writes trace.html next to the trace
    fgreport -p pi4 trace.txt               # kernel paths from preset "pi4"
    fgreport -p pi4 --open trace.txt        # ... and open it in the browser
    fgreport --lite trace.txt               # text view + timeline only, no source/links (fast)
    fgreport trace.txt -- --pid 1234        # anything after -- goes to funcgraph.py unchanged

Kernel paths are kept in presets of funcgraph's config file (~/.config/funcgraph/config.ini):

    fgreport init pi4 --vmlinux /vol_1t/raspi/linux/vmlinux --kernel-src /vol_1t/raspi/linux \\
             --cross-compile aarch64-linux-gnu- --source-browser github --source-browser-rev v6.18
    fgreport init vm72 --vmlinux /vol_1t/Qemu/trim_retval/x86_64/vmlinux \\
             --kernel-src /vol_1t/Qemu/trim_retval --source-rev HEAD --default
    fgreport presets                        # list them (* = used when -p is not given)

The preset used without -p: $FG_PRESET, else the one marked with --default.
Directory modes (--report-mode sidecar/auto) keep Text and use .report;
auto needs --sidecar-threshold BYTES. Their --open runs fgview until Ctrl+C.
Large offline reports default to gzip-windowed HTML without dropping Text.
Use --report-mode single --text for eager Full Text even on large inputs.
"""
import argparse
import configparser
import os
import shlex
import subprocess
import sys
import webbrowser

from fglib.constants import PROJECT_DIR
from fglib.raw import MAGIC

FUNCGRAPH = os.path.join(PROJECT_DIR, 'funcgraph.py')
CONFIG = os.path.join(os.path.expanduser('~'), '.config', 'funcgraph', 'config.ini')
BIG = 150000          # lines; above this the text view is too heavy for browsers
PRESET_KEYS = ('vmlinux', 'kernel-src', 'base-url', 'source-browser', 'source-browser-rev', 'source-rev', 'source-url', 'cross-compile', 'llvm',
               'module-dirs', 'module-srcs', 'path-prefix', 'btf', 'overhead', 'report-mode', 'sidecar-threshold', 'windowed-compression')


def die(msg):
    print(f'fgreport: {msg}', file=sys.stderr)
    sys.exit(2)


def config_path():
    return os.environ.get('FG_CONFIG') or CONFIG


def read_config():
    cp = configparser.ConfigParser(interpolation=None, inline_comment_prefixes=('#', ';'))
    cp.optionxform = str
    p = config_path()
    if os.path.isfile(p):
        with open(p, encoding='utf-8') as f:
            cp.read_file(f)
    return cp


def presets(cp):
    return [s[7:] for s in cp.sections() if s.startswith('preset ')]


def default_preset(cp):
    if os.environ.get('FG_PRESET'):
        return os.environ['FG_PRESET']
    # [fgreport] is ignored by funcgraph.py itself
    return cp.get('fgreport', 'preset', fallback=None) or None


# ---- subcommands ----
def cmd_init(argv):
    ap = argparse.ArgumentParser(prog='fgreport init', description='Create or update a preset with kernel paths.')
    ap.add_argument('name')
    for k in PRESET_KEYS:
        ap.add_argument('--' + k, metavar='VALUE')
    ap.add_argument('--default', action='store_true', help='use this preset when -p is not given')
    a = ap.parse_args(argv)
    vals = {k: getattr(a, k.replace('-', '_')) for k in PRESET_KEYS if getattr(a, k.replace('-', '_'))}
    for k in ('vmlinux', 'kernel-src'):
        if k in vals and not os.path.exists(vals[k]):
            print(f'fgreport: warning: {k} {vals[k]} does not exist (yet)', file=sys.stderr)
    cp = read_config()
    sec = 'preset ' + a.name
    if not cp.has_section(sec):
        cp.add_section(sec)
    if a.source_browser is not None and a.base_url is None:
        cp.remove_option(sec, 'base-url')
        cp.remove_option(sec, 'base_url')
    for k, v in vals.items():
        cp[sec][k] = os.path.abspath(v) if k in ('vmlinux', 'kernel-src') else v
    if a.default:
        if not cp.has_section('fgreport'):
            cp.add_section('fgreport')
        cp['fgreport']['preset'] = a.name
    p = config_path()
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, 'w', encoding='utf-8') as f:
        cp.write(f)
    print(f'fgreport: preset {a.name} written to {p}' + (' (default)' if a.default else ''))


def cmd_presets(_argv):
    cp = read_config()
    names = presets(cp)
    if not names:
        print(f'no presets in {config_path()}; create one with: fgreport init NAME --vmlinux ... --kernel-src ...')
        return
    d = default_preset(cp)
    for n in names:
        sec = cp['preset ' + n]
        print(('* ' if n == d else '  ') + n)
        for k, v in sec.items():
            print(f'      {k} = {v}')


# ---- report ----
def have(mod):
    try:
        __import__(mod)
        return True
    except ImportError:
        return False


def count_lines(path, limit):
    """Lines of plain text only; compressed, binary and stdin inputs are unknown."""
    if path == '-' or path.endswith(('.gz', '.xz', '.lzma', '.bz2')):
        return None
    n = 0
    with open(path, 'rb') as f:
        if f.read(len(MAGIC)) == MAGIC:
            return None
        f.seek(0)
        for _ in f:
            n += 1
            if n > limit:
                break
    return n


def cmd_report(argv):
    extra = []
    if '--' in argv:
        i = argv.index('--')
        argv, extra = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(
        prog='fgreport', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('traces', nargs='*', metavar='TRACE', help="trace file(s); '-' for stdin, .gz/.xz/.bz2 work")
    ap.add_argument('--uftrace', metavar='DIR', help='recording directory (uses bundled uftrace by default)')
    ap.add_argument('--uftrace-bin', metavar='PATH', help='override the bundled / PATH uftrace executable')
    ap.add_argument('-p', '--preset', help='preset with kernel paths (default: $FG_PRESET or the default preset)')
    ap.add_argument('-P', '--no-preset', action='store_true', help='use no preset (no vmlinux: no source, links or BTF)')
    ap.add_argument('-o', '--output', help='output HTML or report directory (default: next to the first trace, .html or .report)')
    ap.add_argument('--open', action='store_true', help='open the report; directory modes run fgview until Ctrl+C')
    ap.add_argument('--report-mode', choices=('single', 'single-windowed', 'sidecar', 'auto'), help='override the configured or automatic offline output mode')
    ap.add_argument('--windowed-compression', choices=('none', 'gzip'), help='compress embedded data in single-windowed reports')
    ap.add_argument('--sidecar-threshold', type=int, metavar='BYTES', help='auto mode threshold in complete uncompressed HTML bytes')
    ap.add_argument('--lite', action='store_true', help='text view + timeline only: no source blocks, links, highlighting')
    ap.add_argument('--text', action='store_true', help=f'keep Full Text above {BIG} input lines in explicit single mode')
    ap.add_argument('-c', '--compare', metavar='BASE', help='add a Compare tab against this trace')
    ap.add_argument('-n', '--dry-run', action='store_true', help='print the funcgraph.py command and exit')
    a = ap.parse_args(argv)
    if bool(a.uftrace) == bool(a.traces):
        ap.error('supply trace file(s) or --uftrace DIR, not both')
    if a.uftrace:
        extra = ['--uftrace', a.uftrace] + extra
    if a.uftrace_bin:
        extra = ['--uftrace-bin', a.uftrace_bin] + extra

    cp = read_config()
    preset = None if a.no_preset else (a.preset or default_preset(cp))
    if preset and not cp.has_section('preset ' + preset):
        die(f"no preset '{preset}' in {config_path()} (have: {', '.join(presets(cp)) or 'none'}); "
            f"create it with: fgreport init {preset} --vmlinux ... --kernel-src ...")
    cmd = [sys.executable, FUNCGRAPH, '--timeline', '--enable-fold', '--filter']
    if os.path.isfile(config_path()):
        cmd += ['--config', config_path()]
    if preset:
        cmd += ['--preset', preset]
    if a.compare:
        cmd += ['--compare', a.compare]
    if a.report_mode is not None:
        cmd += ['--report-mode', a.report_mode]
    if a.windowed_compression is not None:
        cmd += ['--windowed-compression', a.windowed_compression]
    if a.sidecar_threshold is not None:
        cmd += ['--sidecar-threshold', str(a.sidecar_threshold)]

    from fglib.cli import parse_args
    selection = parse_args(cmd[2:] + ['--output', a.output or ''] + extra + a.traces)
    if selection.vmlinux and not a.lite:
        if not selection.func_links:
            cmd += ['--func-links']
        if not selection.fast and not selection.use_external and have('elftools'):
            cmd += ['--fast']
        if not selection.highlight_code and (selection.kernel_src or selection.source_url) and have('pygments'):
            cmd += ['--highlight-code']
    mode = selection.report_mode
    if mode not in (None, 'single', 'single-windowed', 'sidecar', 'auto'):
        die('report mode must be single, single-windowed, sidecar or auto')
    directory_mode = mode in ('sidecar', 'auto')

    big = False
    if a.traces and not a.text and not selection.no_text_view and mode == 'single':
        n = count_lines(a.traces[0], BIG) if os.path.isfile(a.traces[0]) else None
        if n is not None and n > BIG:
            big = True
            cmd += ['--no-text-view']

    out = selection.output
    if not out:
        suffix = '.report' if directory_mode else '.html'
        first = a.uftrace.rstrip(os.sep) if a.uftrace else a.traces[0]
        if first == '-':
            out = 'stdin' + suffix
        else:
            base = first
            for ext in ('.gz', '.xz', '.bz2'):
                if base.endswith(ext):
                    base = base[:-len(ext)]
            out = (base if a.uftrace else os.path.splitext(base)[0]) + suffix
    cmd += ['--output', out] + extra + a.traces

    print('fgreport: ' + ' '.join(shlex.quote(c) for c in cmd[1:]), file=sys.stderr)
    if big:
        print(f'fgreport: explicit single mode with more than {BIG} input lines: building Timeline only. '
              'Use --text for Full Text or --report-mode single-windowed to keep Text on demand.', file=sys.stderr)
    if a.dry_run:
        return 0
    rc = subprocess.call(cmd)
    if rc == 0:
        print(f'fgreport: {os.path.abspath(out)}', file=sys.stderr)
        if a.open:
            if directory_mode:
                from fglib.viewer import main as view_report
                return view_report([out, '--open'])
            webbrowser.open('file://' + os.path.abspath(out))
    return rc


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == 'init':
        return cmd_init(argv[1:])
    if argv and argv[0] == 'presets':
        return cmd_presets(argv[1:])
    return cmd_report(argv)


if __name__ == '__main__':
    sys.exit(main() or 0)
